<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">收货人</text>
      <input
        class="input"
        placeholder="请输入姓名"
        placeholder-class="ph"
        value="{{form.name}}"
        data-field="name"
        bindinput="onInput"
        maxlength="20"
      />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input
        class="input"
        type="number"
        placeholder="请输入 11 位手机号"
        placeholder-class="ph"
        value="{{form.phone}}"
        data-field="phone"
        bindinput="onInput"
        maxlength="11"
      />
    </view>
    <view class="field field-area">
      <text class="label">详细地址</text>
      <textarea
        class="textarea"
        placeholder="省 / 市 / 区 / 街道 / 门牌号"
        placeholder-class="ph"
        value="{{form.detail}}"
        data-field="detail"
        bindinput="onInput"
        maxlength="80"
        auto-height="{{true}}"
      />
    </view>
  </view>

  <view class="demo-tip" bindtap="fillDemo">一键填充演示地址</view>

  <view class="save-btn {{saving ? 'save-off' : ''}}" bindtap="save">
    {{saving ? '保存中…' : '保存地址'}}
  </view>

  <view class="notice">
    我们仅将地址用于订单配送，不会用于其他用途。
  </view>
</view>
