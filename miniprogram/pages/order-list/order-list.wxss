.page {
  padding-bottom: 40rpx;
}

/* Tab */
.tabs {
  white-space: nowrap;
  background: #fff;
  padding: 0 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  display: inline-block;
  padding: 24rpx 26rpx;
  font-size: 28rpx;
  color: #4a4f57;
  position: relative;
}

.tab-on {
  color: #ff4d4f;
  font-weight: 700;
}

.tab-on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  transform: translateX(-50%);
  width: 36rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: #ff4d4f;
}

/* 订单 */
.list {
  padding: 16rpx 20rpx;
}

.order {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
}

.o-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.o-no {
  font-size: 22rpx;
  color: #9aa0a6;
}

.o-status {
  font-size: 24rpx;
  font-weight: 600;
  color: #ff4d4f;
}

.status-done,
.status-closed {
  color: #9aa0a6;
}

/* 商品行 */
.o-goods {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.g-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.g-info {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.g-name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-sku {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.g-right {
  text-align: right;
}

.g-price {
  font-size: 26rpx;
}

.g-qty {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
}

.o-meta {
  font-size: 22rpx;
  color: #b0b4bb;
  padding-top: 6rpx;
}

.o-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 14rpx;
  border-top: 1rpx solid #f2f3f5;
}

.o-amount {
  font-size: 24rpx;
  color: #4a4f57;
}

.o-amount .price {
  font-size: 32rpx;
}

.o-actions {
  display: flex;
}

.act {
  padding: 10rpx 26rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  margin-left: 14rpx;
}

.ghost {
  border: 1rpx solid #d5d9e0;
  color: #4a4f57;
}

.primary {
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
  color: #fff;
  font-weight: 600;
}

.go-btn {
  margin-top: 30rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 28rpx;
}
