.page {
  padding: 16rpx 20rpx 150rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}

/* 地址 */
.addr {
  display: flex;
  align-items: center;
}

.addr-ico {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.addr-main {
  flex: 1;
  min-width: 0;
}

.addr-line1 {
  display: flex;
  align-items: baseline;
}

.addr-name {
  font-size: 30rpx;
  font-weight: 600;
}

.addr-phone {
  font-size: 24rpx;
  color: #8a8f99;
  margin-left: 16rpx;
}

.addr-detail {
  font-size: 24rpx;
  color: #4a4f57;
  margin-top: 8rpx;
  line-height: 1.45;
}

.addr-empty {
  font-size: 28rpx;
  color: #8a8f99;
}

.addr-arrow {
  font-size: 34rpx;
  color: #c8ccd2;
  margin-left: 10rpx;
}

/* 商品 */
.goods-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.g-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  flex-shrink: 0;
}

.g-info {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.g-name {
  font-size: 26rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.g-sku {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

.g-right {
  text-align: right;
}

.g-right .price {
  font-size: 28rpx;
}

.g-qty {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 8rpx;
}

/* 行 */
.row-card {
  display: flex;
  align-items: center;
}

.row-key {
  font-size: 26rpx;
  color: #4a4f57;
  width: 150rpx;
  flex-shrink: 0;
}

.row-val {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.coupon-tag {
  font-size: 24rpx;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.row-none {
  font-size: 24rpx;
  color: #9aa0a6;
}

.row-arrow {
  font-size: 32rpx;
  color: #c8ccd2;
  margin-left: 8rpx;
}

.remark-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.ph {
  color: #b0b4bb;
}

/* 金额 */
.sum-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 10rpx 0;
}

.sum-key {
  font-size: 26rpx;
  color: #4a4f57;
}

.sum-val {
  font-size: 26rpx;
  color: #1a1a1a;
}

.discount {
  color: #ff4d4f;
}

.price-lg {
  font-size: 38rpx;
}

.notice {
  font-size: 22rpx;
  color: #b0b4bb;
  line-height: 1.6;
  padding: 6rpx 8rpx 0;
}

/* 底部 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(20, 25, 40, 0.06);
}

.bar-sum {
  flex: 1;
  display: flex;
  align-items: baseline;
}

.bar-label {
  font-size: 24rpx;
  color: #4a4f57;
  margin-right: 8rpx;
}

.submit {
  width: 240rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-off {
  background: #d9dce2;
}
