.page {
  padding-bottom: 20rpx;
}

/* 搜索 */
.topbar {
  background: #fff;
  padding: 16rpx 24rpx 20rpx;
}

.search {
  height: 72rpx;
  background: #f2f3f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 26rpx;
}

.search-ico {
  font-size: 28rpx;
  margin-right: 14rpx;
}

.search-ph {
  color: #9aa0a6;
  font-size: 26rpx;
}

/* 轮播 */
.banner {
  height: 268rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
}

.banner-item {
  height: 268rpx;
  padding: 46rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  color: #fff;
}

.banner-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.banner-sub {
  font-size: 26rpx;
  margin-top: 10rpx;
  opacity: 0.92;
}

.banner-btn {
  margin-top: 22rpx;
  align-self: flex-start;
  font-size: 24rpx;
  padding: 8rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.26);
}

/* 券条 */
.coupon-strip {
  margin: 20rpx 24rpx 0;
  padding: 20rpx 26rpx;
  border-radius: 18rpx;
  background: linear-gradient(90deg, #fff1f0, #fff8e6);
  display: flex;
  align-items: center;
}

.cs-ico {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.cs-main {
  flex: 1;
  min-width: 0;
}

.cs-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #d4380d;
}

.cs-sub {
  font-size: 22rpx;
  color: #b06a3b;
  margin-top: 4rpx;
}

.cs-go {
  font-size: 24rpx;
  color: #d4380d;
}

/* 区块 */
.section {
  margin-top: 30rpx;
}

.sec-head {
  display: flex;
  align-items: baseline;
  padding: 0 24rpx 16rpx;
}

.sec-title {
  font-size: 34rpx;
  font-weight: 700;
}

.sec-sub {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-left: 14rpx;
}

/* 秒杀 */
.flash {
  white-space: nowrap;
  padding: 0 24rpx;
}

.flash-item {
  display: inline-block;
  width: 190rpx;
  margin-right: 18rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  padding-bottom: 14rpx;
}

.flash-thumb {
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.flash-name {
  font-size: 22rpx;
  color: #4a4f57;
  padding: 10rpx 12rpx 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flash-price {
  padding: 4rpx 12rpx 0;
  color: #ff4d4f;
  font-weight: 700;
  font-size: 28rpx;
}

/* 商品网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.card {
  width: calc(50% - 16rpx);
  margin: 0 8rpx 16rpx;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
}

.card-thumb {
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
}

.card-body {
  padding: 16rpx 18rpx 20rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.card-sub {
  font-size: 22rpx;
  color: #9aa0a6;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tag {
  font-size: 18rpx;
  color: #ff4d4f;
  border: 1rpx solid rgba(255, 77, 79, 0.4);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
  line-height: 1.5;
}

.card-foot {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.card-foot .price {
  font-size: 34rpx;
}

.card-foot .origin {
  margin-left: 10rpx;
}

.sales {
  margin-left: auto;
  font-size: 20rpx;
  color: #b0b4bb;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #b0b4bb;
  padding: 30rpx 0 10rpx;
}
