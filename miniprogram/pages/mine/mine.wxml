<view class="page">
  <!-- 头部 -->
  <view class="header">
    <view class="avatar">{{userInfo.avatar}}</view>
    <view class="user">
      <view class="nick">{{userInfo.nickName}}</view>
      <view class="uid">会员编号 {{'M' + (orderCount + 1000)}}</view>
    </view>
    <view class="coupon-chip" bindtap="goCoupon">
      <text>{{couponCount}}</text> 张券 ›
    </view>
  </view>

  <!-- 订单 -->
  <view class="card">
    <view class="card-head">
      <text class="card-title">我的订单</text>
      <text class="card-more" data-tab="all" bindtap="goOrders">全部订单 ›</text>
    </view>
    <view class="order-grid">
      <view class="order-item" data-tab="1" bindtap="goOrders">
        <text class="oi-ico">💳</text>
        <text class="oi-label">待付款</text>
        <view class="badge" wx:if="{{counts.unpaid > 0}}">{{counts.unpaid}}</view>
      </view>
      <view class="order-item" data-tab="2" bindtap="goOrders">
        <text class="oi-ico">📦</text>
        <text class="oi-label">待发货</text>
        <view class="badge" wx:if="{{counts.unshipped > 0}}">{{counts.unshipped}}</view>
      </view>
      <view class="order-item" data-tab="3" bindtap="goOrders">
        <text class="oi-ico">🚚</text>
        <text class="oi-label">待收货</text>
        <view class="badge" wx:if="{{counts.shipped > 0}}">{{counts.shipped}}</view>
      </view>
      <view class="order-item" data-tab="4" bindtap="goOrders">
        <text class="oi-ico">✅</text>
        <text class="oi-label">已完成</text>
        <view class="badge" wx:if="{{counts.done > 0}}">{{counts.done}}</view>
      </view>
    </view>
  </view>

  <!-- 功能 -->
  <view class="card cells">
    <view class="cell" bindtap="goCoupon">
      <text class="cell-ico">🎫</text>
      <text class="cell-label">我的优惠券</text>
      <text class="cell-val">{{couponCount}} 张可用</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="goAddress">
      <text class="cell-ico">📍</text>
      <text class="cell-label">收货地址</text>
      <text class="cell-val"></text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onService">
      <text class="cell-ico">💬</text>
      <text class="cell-label">联系客服</text>
      <text class="cell-val">9:00 - 21:00</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onAbout">
      <text class="cell-ico">ℹ️</text>
      <text class="cell-label">关于本商城</text>
      <text class="cell-val">v1.0.0</text>
      <text class="cell-arrow">›</text>
    </view>
    <view class="cell" bindtap="onReset">
      <text class="cell-ico">🧹</text>
      <text class="cell-label">清除演示数据</text>
      <text class="cell-val"></text>
      <text class="cell-arrow">›</text>
    </view>
  </view>

  <view class="tip">本小程序为演示版本，支付与发货均为模拟流程</view>
</view>
