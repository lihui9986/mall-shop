page {
  --brand: #ff4d4f;
  --brand-dark: #e63b3d;
  --bg: #f5f6f8;
  --text: #1a1a1a;
  --text-sub: #8a8f99;
  --line: #eceef2;

  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
}

view,
text,
scroll-view,
swiper,
input,
textarea,
button {
  box-sizing: border-box;
}

/* ---------- 通用 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.price {
  color: var(--brand);
  font-weight: 700;
}

.rmb {
  font-size: 22rpx;
  margin-right: 2rpx;
}

.origin {
  color: #b0b4bb;
  font-size: 22rpx;
  text-decoration: line-through;
}

.card-shadow {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 25, 40, 0.04);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #ff7875, #ff4d4f);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.86;
}

.btn-ghost {
  background: #fff;
  color: var(--brand);
  border: 2rpx solid var(--brand);
}

.btn-plain {
  background: #f2f3f5;
  color: var(--text);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 140rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-sub);
  font-size: 26rpx;
}

.empty-ico {
  font-size: 96rpx;
  margin-bottom: 20rpx;
  opacity: 0.6;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 20rpx 0;
}
